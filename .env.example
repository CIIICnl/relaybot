# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o

# Notion
NOTION_SECRET=ntn_...
NOTION_EVENTS_DATABASE_ID=your-events-database-id
NOTION_CONTENT_DATABASE_ID=your-content-database-id
NOTION_INBOX_DATABASE_ID=your-inbox-database-id

# Brevo (for sending reply emails)
BREVO_API_KEY=xsmtpsib-...
BREVO_API_KEY2=xkeysib-...

# Slack (for Slack bot integration)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Zapier (for notifications)
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/...

# Intake ticket endpoint (chatbot → Notion "Website 2026 bugs & doorontwikkeling")
# Shared bearer secret between ciiicbot and the relay. Generate a random string.
INTAKE_TOKEN=change-me-shared-secret
# Optional: override the target database-id (defaults to the known bugs DB id).
# NOTION_BUGS_DATABASE_ID=34b11fb0-8c9e-803b-aedd-e3d19964c8a1
# Optional: extra chatbot-email → notion-email overrides as a JSON object.
# Merged on top of src/config/email-overrides.json. Example:
# INTAKE_EMAIL_OVERRIDES={"heleen@ciiic.nl":"heleen.private@gmail.com"}

# Radar signals — daily scan of the source allowlist → monitor ingest endpoint.
# Shared bearer secret with monitor (must match monitor's RADAR_INGEST_SECRET).
# Without it, the scheduler + /radar/scan are disabled.
RADAR_INGEST_SECRET=change-me-shared-with-monitor
# Optional overrides:
# RADAR_INGEST_URL=https://monitor.ciiic.nl/api/radar/ingest
# RADAR_SCAN_REPORT_URL=...     # scan-health endpoint (default: /scan-report sibling of ingest URL)
# RADAR_RELEVANCE_FLOOR=30      # don't POST candidates scored below this (monitor shows >=50)
# RADAR_MAX_PER_SOURCE=40       # cap new/changed items processed per source per run
# RADAR_SCAN_HOUR=7             # daily scan hour, Europe/Amsterdam
# RADAR_DB_PATH=/data/radar.sqlite
# RADAR_SHEET_GID=              # target a specific Google Sheet tab (default: first tab)
# RADAR_ENABLE_IMMERSIVEWIRE=1  # enable the Immersive Wire RSS source (off in v1; digest extraction is noisy)
#
# --- phase 2 (research + funding) ---
# RADAR_SEDIA_PAGES=3           # EU funding: SEDIA search pages to pull per run
# RADAR_SEDIA_PAGE_SIZE=100     # EU funding: results per SEDIA page (topics are sparse in the mix)
# RADAR_FUNDING_MAX_CLOSED_DAYS=430  # drop closed calls whose deadline is older than this
# RADAR_ENABLE_EUREKALERT=1     # enable EurekAlert research feed (off: keyword feed URL 404s, needs a working feed)
# RADAR_EUREKALERT_RSS=...      # override the EurekAlert feed URL when re-enabling
# RADAR_ENABLE_SPRINGER=1       # enable Springer VR feed (off: blocks server-side fetch with a JS challenge)
# RADAR_ENABLE_NATURE=1         # enable Nature Scientific Reports feed (off: same JS challenge)

# Deployment (for Docker/Caddy)
DOMAIN=bot.ciiic.nl
LETSENCRYPT_EMAIL=admin@ciiic.nl

# Draft-resume store (publicvalues.ciiic.nl). Optional.
# DRAFT_DB_PATH=/data/drafts.sqlite
